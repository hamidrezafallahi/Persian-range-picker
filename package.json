  "scripts": {
    "dev": "vite",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "rollup -c",
    "build": "npm run build:js && npm run build:types",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean:generated": "powershell -ExecutionPolicy Bypass -File scripts/clean-generated.ps1"

  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
