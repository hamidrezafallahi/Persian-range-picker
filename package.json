{
  "name": "react-persian-range-picker",
  "version": "1.0.6",
  "license": "MIT",
  "type": "module",
  "main": "dist/persian-range-picker.umd.js",
  "module": "dist/persian-range-picker.es.js",
  "types": "dist/index.d.ts",
  "author": "hamidreza fallahi",
  "keywords": [
    "react",
    "date picker",
    "range picker",
    "compare picker",
    "compare",
    "persian date",
    "react datepicker",
    "time picker",
    "datepicker range",
    "react persian calendar",
    "date range picker",
    "comparison range picker"
  ],
  "description": "A React-based Persian (Jalali) date and time range picker with mask input, customizable dropdown rendering, and built-in date range comparison.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/persian-range-picker.es.js",
      "require": "./dist/persian-range-picker.umd.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hamidrezafallahi/Persian-range-picker.git"
  },
  "bugs": {
    "url": "https://github.com/hamidrezafallahi/Persian-range-picker/issues"
  },
  "homepage": "https://github.com/hamidrezafallahi/persian-range-picker#readme",
  "scripts": {
    "dev": "vite",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "rollup -c",
    "build": "npm run build:js && npm run build:types",
    "dev:demo": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "deploy:demo": "gh-pages -d demo/dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean:generated": "powershell -ExecutionPolicy Bypass -File scripts/clean-generated.ps1"
  },
  "dependencies": {
    "moment-jalaali": "^0.10.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/moment-jalaali": "^0.7.9",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "moment-jalaali": "^0.10.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "rollup": "^4.41.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
